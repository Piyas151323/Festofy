{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in Festofy",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "User's full name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["displayName", "email", "createdAt", "updatedAt"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "User RBAC role assignment in Festofy",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["student", "organizer", "admin"],
          "description": "Role determining permissions across the platform"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Role creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Role last updated timestamp"
        }
      },
      "required": ["role", "createdAt", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Student club or host organization",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Organization name",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Organization summary and about",
          "maxLength": 2000
        },
        "logoUrl": {
          "type": "string",
          "description": "Organization logo URL",
          "maxLength": 500
        },
        "institution": {
          "type": "string",
          "description": "Affiliated college or school name",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "suspended"],
          "description": "Lifecycle and verification status of the organization"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Administrative feedback or reason if rejected",
          "maxLength": 1000
        },
        "requestedBy": {
          "type": "string",
          "description": "Firebase UID of student who submitted the application",
          "maxLength": 128
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when application was submitted"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["name", "status", "createdAt", "updatedAt"]
    },
    "OrganizationMember": {
      "title": "OrganizationMember",
      "description": "Membership mapping a user to an organization with a specific role",
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "description": "ID of the organization",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Firebase UID of member",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["owner", "organizer"],
          "description": "Role inside the organization"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Membership creation timestamp"
        }
      },
      "required": ["organizationId", "userId", "role", "createdAt"]
    },
    "Fest": {
      "title": "Fest",
      "description": "Festival or summit hosted by a student organization",
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "description": "Parent organization ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Fest title",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Fest description",
          "maxLength": 3000
        },
        "bannerUrl": {
          "type": "string",
          "description": "Banner image URL",
          "maxLength": 500
        },
        "startDate": {
          "type": "string",
          "description": "Start date/time ISO string or timestamp"
        },
        "endDate": {
          "type": "string",
          "description": "End date/time ISO string or timestamp"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "completed", "archived"],
          "description": "Current publication state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["organizationId", "name", "description", "startDate", "endDate", "status", "createdAt", "updatedAt"]
    },
    "EventCategory": {
      "title": "EventCategory",
      "description": "Category tags for competitions and workshops",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Category name",
          "maxLength": 80
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly category slug",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Category description",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "slug", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Specific competition, contest, or workshop within a fest",
      "type": "object",
      "properties": {
        "festId": {
          "type": "string",
          "description": "Parent Fest ID",
          "maxLength": 128
        },
        "organizationId": {
          "type": "string",
          "description": "Denormalized Parent Organization ID",
          "maxLength": 128
        },
        "categoryId": {
          "type": "string",
          "description": "Event category reference",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Event name",
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "description": "Event details",
          "maxLength": 3000
        },
        "bannerUrl": {
          "type": "string",
          "description": "Event banner URL",
          "maxLength": 500
        },
        "venue": {
          "type": "string",
          "description": "Physical room or online platform",
          "maxLength": 200
        },
        "startTime": {
          "type": "string",
          "description": "Start time ISO string or timestamp"
        },
        "endTime": {
          "type": "string",
          "description": "End time ISO string or timestamp"
        },
        "registrationDeadline": {
          "type": "string",
          "description": "Deadline for student sign-up"
        },
        "capacity": {
          "type": "number",
          "description": "Maximum allowed participants"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "completed", "cancelled"],
          "description": "Current publication state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["festId", "organizationId", "categoryId", "name", "description", "venue", "startTime", "endTime", "registrationDeadline", "capacity", "status", "createdAt", "updatedAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Student enrollment record for an event",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Target event ID",
          "maxLength": 128
        },
        "festId": {
          "type": "string",
          "description": "Target fest ID",
          "maxLength": 128
        },
        "organizationId": {
          "type": "string",
          "description": "Target organization ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Student UID",
          "maxLength": 128
        },
        "ticketCode": {
          "type": "string",
          "description": "Human-readable digital pass identifier",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "waitlisted", "cancelled", "completed", "checked_in"],
          "description": "Registration lifecycle status"
        },
        "registrationType": {
          "type": "string",
          "enum": ["individual", "team"],
          "description": "Whether registration is individual or team"
        },
        "studentName": {
          "type": "string",
          "description": "Snapshot of participant full name",
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "description": "Snapshot of participant email",
          "maxLength": 150
        },
        "eventName": {
          "type": "string",
          "description": "Snapshot of event name",
          "maxLength": 150
        },
        "festName": {
          "type": "string",
          "description": "Snapshot of festival name",
          "maxLength": 150
        },
        "venue": {
          "type": "string",
          "description": "Snapshot of event location or hall",
          "maxLength": 200
        },
        "startTime": {
          "type": "string",
          "description": "Event start time ISO timestamp"
        },
        "registrationData": {
          "type": "object",
          "description": "Map containing participant responses and custom question answers"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Registration submission timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Registration update timestamp"
        },
        "cancelledAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when registration was cancelled"
        },
        "cancellationReason": {
          "type": "string",
          "description": "Optional cancellation reason provided by student",
          "maxLength": 500
        }
      },
      "required": ["eventId", "festId", "organizationId", "userId", "status", "registeredAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Auth UID"
    },
    "/userRoles/{userId}": {
      "schema": "UserRole",
      "description": "User role document keyed by Auth UID"
    },
    "/organizations/{organizationId}": {
      "schema": "Organization",
      "description": "Student clubs and organizations"
    },
    "/organizationMembers/{membershipId}": {
      "schema": "OrganizationMember",
      "description": "Membership document linking user and organization"
    },
    "/fests/{festId}": {
      "schema": "Fest",
      "description": "Fests hosted by organizations"
    },
    "/eventCategories/{categoryId}": {
      "schema": "EventCategory",
      "description": "Competition categories"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Individual contests, challenges, and workshops"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Event registrations"
    }
  }
}
