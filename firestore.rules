rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all: Deny all reads and writes unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document: Allows unauthenticated single-document get for health checks
    match /test/{testId} {
      allow get: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authoritative Admin: Verified role in userRoles collection.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid))
      );
    }

    function isOrgOwner(orgId) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + request.auth.uid)).data.role == 'owner')
      );
    }

    function isApprovedOrg(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (!('status' in get(/databases/$(database)/documents/organizations/$(orgId)).data) ||
         get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'approved');
    }

    function isValidFestPayload(data) {
      return data.name is string &&
        data.name.size() >= 3 &&
        data.name.size() <= 150 &&
        data.description is string &&
        data.description.size() >= 3 &&
        data.description.size() <= 3000 &&
        data.startDate is string &&
        data.endDate is string &&
        data.startDate <= data.endDate &&
        (!('bannerUrl' in data) || data.bannerUrl == null || (data.bannerUrl is string && data.bannerUrl.size() <= 500));
    }

    function isValidEventPayload(data) {
      return data.name is string &&
        data.name.size() >= 3 &&
        data.name.size() <= 150 &&
        data.description is string &&
        data.description.size() >= 3 &&
        data.description.size() <= 3000 &&
        data.venue is string &&
        data.venue.size() >= 2 &&
        data.venue.size() <= 100 &&
        data.startTime is string &&
        data.endTime is string &&
        data.startTime <= data.endTime &&
        data.registrationDeadline is string &&
        data.registrationDeadline <= data.startTime &&
        data.registrationDeadline <= data.endTime &&
        data.capacity is int &&
        data.capacity >= 1 &&
        data.capacity <= 100000;
    }

    // USERS COLLECTION (Private User Profiles)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt']) &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 150;
      allow update: if isOwner(userId) &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'institution', 'classGrade',
          'participantCategory', 'studentId', 'interests', 'isProfileComplete', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }

    // USER ROLES COLLECTION (RBAC Enforcement)
    // New accounts can only initialize their own role strictly as 'student'.
    // Students and organizers CANNOT self-promote or modify any user role.
    match /userRoles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) &&
        request.resource.data.role == 'student' &&
        request.resource.data.keys().hasAll(['role', 'createdAt', 'updatedAt'])) ||
        isAdmin();
      allow update, delete: if isAdmin();
    }

    // ORGANIZATIONS COLLECTION (Clubs & Applications)
    // - Approved clubs (and legacy docs) are public.
    // - Pending, rejected, and suspended organization requests are private to requester and admins.
    // - Authenticated students may create organization requests strictly with status 'pending' and requestedBy == auth.uid.
    // - Status transitions to approved/rejected/suspended are strictly restricted to administrators.
    match /organizations/{organizationId} {
      allow get: if resource == null ||
        (!('status' in resource.data) || resource.data.status == 'approved') ||
        (isSignedIn() && (
          resource.data.requestedBy == request.auth.uid ||
          isAdmin() ||
          isOrgMember(organizationId)
        ));
      allow list: if (!('status' in resource.data) || resource.data.status == 'approved') ||
        (isSignedIn() && (
          resource.data.requestedBy == request.auth.uid ||
          isAdmin()
        ));
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.status == 'pending' &&
          request.resource.data.requestedBy == request.auth.uid &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 2 &&
          request.resource.data.name.size() <= 120 &&
          request.resource.data.keys().hasAll(['name', 'status', 'requestedBy', 'requestedAt', 'createdAt', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['id', 'name', 'description', 'logoUrl', 'institution', 'status', 'rejectionReason', 'requestedBy', 'requestedAt', 'createdAt', 'updatedAt'])
        )
      );
      allow update: if isSignedIn() && (
        // Admin Approval: Pending -> Approved atomically coupled with organizer promotion & owner membership
        (
          isAdmin() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'approved' &&
          request.resource.data.requestedBy == resource.data.requestedBy &&
          existsAfter(/databases/$(database)/documents/userRoles/$(resource.data.requestedBy)) &&
          getAfter(/databases/$(database)/documents/userRoles/$(resource.data.requestedBy)).data.role == 'organizer' &&
          existsAfter(/databases/$(database)/documents/organizationMembers/$(organizationId + '_' + resource.data.requestedBy)) &&
          getAfter(/databases/$(database)/documents/organizationMembers/$(organizationId + '_' + resource.data.requestedBy)).data.organizationId == organizationId &&
          getAfter(/databases/$(database)/documents/organizationMembers/$(organizationId + '_' + resource.data.requestedBy)).data.userId == resource.data.requestedBy &&
          getAfter(/databases/$(database)/documents/organizationMembers/$(organizationId + '_' + resource.data.requestedBy)).data.role == 'owner'
        ) ||
        // Admin Rejection: Pending -> Rejected
        (
          isAdmin() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.requestedBy == resource.data.requestedBy
        ) ||
        // Admin Suspension: Approved -> Suspended
        (
          isAdmin() &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'suspended'
        ) ||
        // General metadata updates on already approved organizations
        (
          (isAdmin() || isOrgMember(organizationId)) &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'approved'
        )
      );
      allow delete: if isAdmin() || (isOrgOwner(organizationId) && (!('status' in resource.data) || resource.data.status == 'approved'));
    }

    // ORGANIZATION MEMBERS (Private Membership Mapping)
    // Accessible strictly via deterministic key {orgId}_{userId} or filtered by member/org.
    // Ordinary students CANNOT enumerate all memberships or self-assign ownership.
    match /organizationMembers/{membershipId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isOrgMember(resource.data.organizationId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        isOrgOwner(request.resource.data.organizationId)
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        isOrgOwner(resource.data.organizationId)
      );
    }

    // FESTS COLLECTION (Public Discovery & Lifecycle Control)
    // - Public: Only published and completed fests are public. Draft and archived fests require organization membership or admin.
    // - Create: Authenticated organizer who is a member of an approved organization may create a fest strictly with status == 'draft' and valid dates.
    // - Update:
    //     (1) Metadata edits on draft/published fests by org members, keeping organizationId and createdAt immutable.
    //     (2) Controlled lifecycle transitions:
    //         - draft -> published (requires valid dates and approved org)
    //         - published -> completed
    //         - completed -> archived
    //     (3) Admin override.
    // - Delete: Only draft fests can be deleted by org members (or admins).
    match /fests/{festId} {
      allow get: if resource.data.status in ['published', 'completed'] ||
        (isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId)));
      allow list: if resource.data.status in ['published', 'completed'] ||
        (isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId)));

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(request.resource.data.organizationId) &&
          isApprovedOrg(request.resource.data.organizationId) &&
          request.resource.data.status == 'draft' &&
          isValidFestPayload(request.resource.data) &&
          request.resource.data.keys().hasAll(['id', 'organizationId', 'name', 'description', 'startDate', 'endDate', 'status', 'createdAt', 'updatedAt']) &&
          (request.resource.data.keys().hasOnly(['id', 'organizationId', 'name', 'description', 'startDate', 'endDate', 'status', 'bannerUrl', 'organizationName', 'organizationLogo', 'createdAt', 'updatedAt']) ||
           request.resource.data.keys().hasOnly(['id', 'organizationId', 'name', 'description', 'startDate', 'endDate', 'status', 'bannerUrl', 'organizationName', 'organizationLogo', 'eventCount', 'createdAt', 'updatedAt']) ||
           request.resource.data.keys().hasOnly(['id', 'organizationId', 'name', 'description', 'startDate', 'endDate', 'status', 'bannerUrl', 'organizationName', 'organizationLogo', 'eventCount', 'visitorAccess', 'participantCategories', 'createdAt', 'updatedAt'])) &&
          (!('eventCount' in request.resource.data) || request.resource.data.eventCount == 0)
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(resource.data.organizationId) &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.id == resource.data.id &&
          (
            // 1. Metadata updates on draft fests (remains draft)
            (
              resource.data.status == 'draft' &&
              request.resource.data.status == 'draft' &&
              isValidFestPayload(request.resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'startDate', 'endDate', 'bannerUrl', 'organizationName', 'organizationLogo', 'visitorAccess', 'participantCategories', 'updatedAt'])
            ) ||
            // 2. Metadata updates on published fests (remains published)
            (
              resource.data.status == 'published' &&
              request.resource.data.status == 'published' &&
              isValidFestPayload(request.resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'startDate', 'endDate', 'bannerUrl', 'organizationName', 'organizationLogo', 'visitorAccess', 'participantCategories', 'updatedAt'])
            ) ||
            // 3. Lifecycle Transition: draft -> published
            (
              resource.data.status == 'draft' &&
              request.resource.data.status == 'published' &&
              isApprovedOrg(resource.data.organizationId) &&
              isValidFestPayload(request.resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'name', 'description', 'startDate', 'endDate', 'bannerUrl', 'organizationName', 'organizationLogo', 'visitorAccess', 'participantCategories'])
            ) ||
            // 4. Lifecycle Transition: published -> completed
            (
              resource.data.status == 'published' &&
              request.resource.data.status == 'completed' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            // 5. Lifecycle Transition: completed -> archived
            (
              resource.data.status == 'completed' &&
              request.resource.data.status == 'archived' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            ) ||
            // 6. Atomic eventCount increment/decrement coupled with event mutations
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventCount', 'updatedAt']) &&
              (
                (request.resource.data.eventCount == (('eventCount' in resource.data && resource.data.eventCount != null) ? resource.data.eventCount + 1 : 1)) ||
                ('eventCount' in resource.data && resource.data.eventCount > 0 && request.resource.data.eventCount == resource.data.eventCount - 1)
              )
            )
          )
        )
      );

      allow delete: if isSignedIn() && (
        (isAdmin() || isOrgMember(resource.data.organizationId)) &&
        resource.data.status == 'draft' &&
        (!('eventCount' in resource.data) || resource.data.eventCount == 0)
      );
    }

    // EVENT CATEGORIES (Public Taxonomy & Custom Categories)
    match /eventCategories/{categoryId} {
      allow get, list: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.keys().hasAll(['id', 'name', 'slug', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['id', 'name', 'normalizedName', 'slug', 'description', 'createdBy', 'isCustom', 'group', 'createdAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 2 &&
          request.resource.data.name.size() <= 80 &&
          request.resource.data.slug is string &&
          request.resource.data.slug.size() >= 2 &&
          request.resource.data.slug.size() <= 80
        )
      );
      allow update, delete: if isAdmin();
    }

    // EVENTS COLLECTION (Public Contests & Challenges Lifecycle)
    // Only published and completed events are public; draft/cancelled events require organizer/admin access.
    // Event creation enforces that festId belongs to the exact same organization.
    match /events/{eventId} {
      allow get: if (resource.data.status == 'published' &&
                     resource.data.festStatus == 'published') ||
        (isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId)));
      allow list: if (resource.data.status == 'published' &&
                      resource.data.festStatus == 'published') ||
        (isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId)));

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(request.resource.data.organizationId) &&
          isApprovedOrg(request.resource.data.organizationId) &&
          request.resource.data.status == 'draft' &&
          request.resource.data.currentRegistrations == 0 &&
          exists(/databases/$(database)/documents/fests/$(request.resource.data.festId)) &&
          get(/databases/$(database)/documents/fests/$(request.resource.data.festId)).data.organizationId == request.resource.data.organizationId &&
          request.resource.data.festStatus == get(/databases/$(database)/documents/fests/$(request.resource.data.festId)).data.status &&
          isValidEventPayload(request.resource.data) &&
          // RULE-LEVEL COUPLING (Part B1): Transaction must atomically increment fest.eventCount:
          existsAfter(/databases/$(database)/documents/fests/$(request.resource.data.festId)) &&
          getAfter(/databases/$(database)/documents/fests/$(request.resource.data.festId)).data.eventCount == (
            (('eventCount' in get(/databases/$(database)/documents/fests/$(request.resource.data.festId)).data &&
              get(/databases/$(database)/documents/fests/$(request.resource.data.festId)).data.eventCount != null)
              ? get(/databases/$(database)/documents/fests/$(request.resource.data.festId)).data.eventCount + 1
              : 1)
          )
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(resource.data.organizationId) &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.festId == resource.data.festId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            // 1. Metadata update on draft event
            (
              resource.data.status == 'draft' &&
              request.resource.data.status == 'draft' &&
              isValidEventPayload(request.resource.data) &&
              request.resource.data.currentRegistrations == resource.data.currentRegistrations &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'description', 'categoryId', 'bannerUrl', 'venue',
                'startTime', 'endTime', 'registrationDeadline', 'capacity',
                'registrationType', 'minTeamSize', 'maxTeamSize', 'requiresApproval',
                'customFormFields', 'isRegistrationClosed', 'updatedAt',
                'festName', 'categoryName', 'organizationName',
                'visitorAccess', 'participantCategories', 'isPaid', 'baseFee', 'topics', 'organizerWhatsApp'
              ])
            ) ||
            // 2. Metadata update on published event
            (
              resource.data.status == 'published' &&
              request.resource.data.status == 'published' &&
              isValidEventPayload(request.resource.data) &&
              request.resource.data.currentRegistrations == resource.data.currentRegistrations &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'description', 'categoryId', 'bannerUrl', 'venue',
                'startTime', 'endTime', 'registrationDeadline', 'capacity',
                'registrationType', 'minTeamSize', 'maxTeamSize', 'requiresApproval',
                'customFormFields', 'isRegistrationClosed', 'updatedAt',
                'festName', 'categoryName', 'organizationName',
                'visitorAccess', 'participantCategories', 'isPaid', 'baseFee', 'topics', 'organizerWhatsApp'
              ])
            ) ||
            // 3. Lifecycle Transition: draft -> published (requires parent fest to be published)
            (
              resource.data.status == 'draft' &&
              request.resource.data.status == 'published' &&
              exists(/databases/$(database)/documents/fests/$(resource.data.festId)) &&
              get(/databases/$(database)/documents/fests/$(resource.data.festId)).data.status == 'published' &&
              request.resource.data.festStatus == 'published' &&
              isValidEventPayload(request.resource.data) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'festStatus', 'updatedAt', 'name', 'description', 'categoryId', 'bannerUrl', 'venue',
                'startTime', 'endTime', 'registrationDeadline', 'capacity',
                'registrationType', 'minTeamSize', 'maxTeamSize', 'requiresApproval',
                'customFormFields', 'isRegistrationClosed', 'festName', 'categoryName', 'organizationName',
                'visitorAccess', 'participantCategories', 'isPaid', 'baseFee', 'topics', 'organizerWhatsApp'
              ])
            ) ||
            // 4. Lifecycle Transition: published -> completed
            (
              resource.data.status == 'published' &&
              request.resource.data.status == 'completed' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'isRegistrationClosed'])
            ) ||
            // 5. Lifecycle Transition: published/draft -> cancelled
            (
              resource.data.status in ['published', 'draft'] &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'isRegistrationClosed'])
            ) ||
            // 6. Parent Fest status synchronization
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['festStatus', 'updatedAt']) &&
              exists(/databases/$(database)/documents/fests/$(resource.data.festId)) &&
              request.resource.data.festStatus == get(/databases/$(database)/documents/fests/$(resource.data.festId)).data.status
            )
          )
        ) ||
        // Atomic capacity increment strictly during valid student registration
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentRegistrations']) &&
          request.resource.data.currentRegistrations == (('currentRegistrations' in resource.data && resource.data.currentRegistrations != null) ? resource.data.currentRegistrations + 1 : 1) &&
          resource.data.status == 'published' &&
          (!('capacity' in resource.data) || resource.data.capacity == null || request.resource.data.currentRegistrations <= resource.data.capacity) &&
          existsAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.userId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.eventId == eventId &&
          getAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.status in ['confirmed', 'pending']
        ) ||
        // Atomic capacity decrement strictly during valid student cancellation
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentRegistrations']) &&
          'currentRegistrations' in resource.data &&
          resource.data.currentRegistrations > 0 &&
          request.resource.data.currentRegistrations == resource.data.currentRegistrations - 1 &&
          existsAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.userId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.eventId == eventId &&
          getAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid)).data.status == 'cancelled'
        )
      );

      // Draft event deletion: only draft events with 0 registrations can be deleted
      allow delete: if isSignedIn() && (
        (isAdmin() || isOrgMember(resource.data.organizationId)) &&
        resource.data.status == 'draft' &&
        (!('currentRegistrations' in resource.data) || resource.data.currentRegistrations == 0) &&
        // RULE-LEVEL COUPLING (Part B2): Transaction must atomically decrement fest.eventCount:
        (
          !exists(/databases/$(database)/documents/fests/$(resource.data.festId)) ||
          (
            existsAfter(/databases/$(database)/documents/fests/$(resource.data.festId)) &&
            getAfter(/databases/$(database)/documents/fests/$(resource.data.festId)).data.eventCount == (
              get(/databases/$(database)/documents/fests/$(resource.data.festId)).data.eventCount - 1
            )
          )
        )
      );
    }

    // REGISTRATIONS COLLECTION (Strictly Private Participant Records)
    // Students can ONLY read, list, and create registrations where userId == request.auth.uid.
    // Deterministic key {eventId}_{userId} prevents duplicate concurrent records.
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isOrgMember(resource.data.organizationId)
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isOrgMember(resource.data.organizationId)
      );
      allow create: if isSignedIn() &&
        registrationId == request.resource.data.eventId + '_' + request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.keys().hasAll(['id', 'eventId', 'festId', 'organizationId', 'userId', 'status', 'registeredAt', 'ticketCode']) &&
        (request.resource.data.keys().hasOnly([
          'id', 'eventId', 'festId', 'organizationId', 'userId', 'ticketCode', 'status',
          'registrationType', 'studentName', 'studentEmail', 'studentPhone', 'institution',
          'studentId', 'teamName', 'teamMembers', 'eventName', 'festName', 'categoryName',
          'venue', 'startTime', 'endTime', 'organizationName', 'registrationData',
          'registeredAt', 'updatedAt'
        ]) || request.resource.data.keys().hasOnly([
          'id', 'eventId', 'festId', 'organizationId', 'userId', 'ticketCode', 'status',
          'registrationType', 'studentName', 'studentEmail', 'studentPhone', 'institution',
          'studentId', 'studentPhotoURL', 'classGrade', 'participantCategory', 'appliedFee', 'currency',
          'paymentStatus', 'paymentMethod', 'paymentTransactionId', 'paymentReference', 'paidAt',
          'teamName', 'teamMembers', 'eventName', 'festName', 'categoryName',
          'venue', 'startTime', 'endTime', 'organizationName', 'registrationData',
          'registeredAt', 'updatedAt'
        ])) &&
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.organizationId == request.resource.data.organizationId &&
        get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.festId == request.resource.data.festId &&
        get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.status == 'published' &&
        // Coupled Atomic Counter Increment: Prevents uncounted registrations and capacity bypass
        existsAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        getAfter(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.currentRegistrations == (
          (('currentRegistrations' in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data &&
            get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.currentRegistrations != null)
            ? get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.currentRegistrations + 1
            : 1)
        );
      allow update: if isSignedIn() && (
        // 1. Atomic Student Cancellation: Only permitted when status transitions from pending/confirmed to cancelled
        // and coupled with an atomic decrement of currentRegistrations on the event document.
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          resource.data.status in ['pending', 'confirmed'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'updatedAt']) &&
          existsAfter(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
          getAfter(/databases/$(database)/documents/events/$(resource.data.eventId)).data.currentRegistrations == (get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.currentRegistrations - 1)
        ) ||
        // 2. Organizer / Admin Operational Management
        (
          (isAdmin() || isOrgMember(resource.data.organizationId)) &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.eventId == resource.data.eventId &&
          request.resource.data.festId == resource.data.festId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.ticketCode == resource.data.ticketCode &&
          request.resource.data.registeredAt == resource.data.registeredAt &&
          (
            // A. Check-in: confirmed/pending -> checked_in
            (
              resource.data.status in ['confirmed', 'pending'] &&
              request.resource.data.status == 'checked_in' &&
              request.resource.data.checkedInBy == request.auth.uid &&
              request.resource.data.checkedInAt is string &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkedInAt', 'checkedInBy', 'updatedAt', 'notes'])
            ) ||
            // B. Approval: pending -> confirmed
            (
              resource.data.status == 'pending' &&
              request.resource.data.status == 'confirmed' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'notes'])
            ) ||
            // C. Completion: confirmed/checked_in -> completed
            (
              resource.data.status in ['confirmed', 'checked_in'] &&
              request.resource.data.status == 'completed' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'notes'])
            ) ||
            // D. Waitlisted: pending/confirmed -> waitlisted
            (
              resource.data.status in ['pending', 'confirmed'] &&
              request.resource.data.status == 'waitlisted' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'notes'])
            ) ||
            // E. Organizer Cancellation: pending/confirmed -> cancelled (coupled with capacity decrement)
            (
              resource.data.status in ['pending', 'confirmed'] &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'updatedAt', 'notes']) &&
              existsAfter(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
              getAfter(/databases/$(database)/documents/events/$(resource.data.eventId)).data.currentRegistrations == (get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.currentRegistrations - 1)
            ) ||
            // F. Operational notes update (status unchanged)
            (
              request.resource.data.status == resource.data.status &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updatedAt'])
            )
          )
        )
      );
      allow delete: if isAdmin() || isOrgOwner(resource.data.organizationId);
    }

    // REGISTRATION FORM TEMPLATES (Reusable Organizer Questionnaire Layouts)
    // Organizers can create, read, update, and delete form templates scoped to their organization.
    match /registrationFormTemplates/{templateId} {
      allow get: if isSignedIn() && (
        resource.data.organizationId == 'default' ||
        isOrgMember(resource.data.organizationId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.organizationId == 'default' ||
        isOrgMember(resource.data.organizationId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(request.resource.data.organizationId) &&
          request.resource.data.organizationId != 'default' &&
          request.resource.data.keys().hasAll(['id', 'organizationId', 'name', 'fields', 'createdAt', 'updatedAt'])
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(resource.data.organizationId) &&
          resource.data.organizationId != 'default' &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAt == resource.data.createdAt
        )
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        (
          isOrgMember(resource.data.organizationId) &&
          resource.data.organizationId != 'default'
        )
      );
    }

    // NOTIFICATIONS COLLECTION (Private Student Notification Inbox)
    // - Students can ONLY read, list, update (mark read), and delete notifications where userId == request.auth.uid.
    // - Students CANNOT create notifications for other users (userId must match request.auth.uid).
    // - Event organizers can dispatch recommendation alerts for their organization's events.
    // - Admins retain supervisory administrative control.
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasAll(['id', 'userId', 'title', 'message', 'read', 'createdAt'])
        ) ||
        (
          'organizationId' in request.resource.data &&
          isOrgMember(request.resource.data.organizationId) &&
          request.resource.data.keys().hasAll(['id', 'userId', 'title', 'message', 'read', 'createdAt', 'eventId', 'organizationId'])
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        )
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
